{
  "name": "slab-agents",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "stack:dev": "bash scripts/local-stack.sh",
    "predev": "npm run migrate:latest",
    "dev": "next dev --hostname 127.0.0.1 --port 3009",
    "build": "next build --webpack",
    "build:check": "NEXT_DIST_DIR=.next-check next build --webpack",
    "start": "next start --hostname ${SLAB_AGENTS_HOST:-127.0.0.1} --port ${PORT:-3009}",
    "start:container": "sh scripts/container-entrypoint.sh",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "migrate:make": "knex --knexfile knexfile.cjs migrate:make",
    "migrate:latest": "knex --knexfile knexfile.cjs migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.cjs migrate:rollback",
    "seed:run": "knex --knexfile knexfile.cjs seed:run"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "knex": "^3.2.10",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "picomatch": "^4.0.5",
    "prettier": "^3.9.6",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
